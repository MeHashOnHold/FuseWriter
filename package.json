{
  "name": "fusewriter",
  "version": "0.1.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "tauri": "tauri",
    "rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "verify": "npm run check && npm run test && npm run rust:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeHashOnHold/FuseWriter.git"
  },
  "bugs": {
    "url": "https://github.com/MeHashOnHold/FuseWriter/issues"
  },
  "homepage": "https://github.com/MeHashOnHold/FuseWriter#readme",
  "private": true,
  "type": "module",
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.6",
    "@tsconfig/svelte": "5.0.9",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
